local function enterTank()
    if state.isInTank then return end
    local tankPrompts = {}
    for _, desc in ipairs(workspace:GetDescendants()) do
        if desc:IsA("ProximityPrompt") and desc.Name == CONFIG.TANK_PROMPT_NAME then
            table.insert(tankPrompts, desc)
        end
    end
    if #tankPrompts > 0 then
        for _, prompt in ipairs(tankPrompts) do
            firePromptStandard(prompt)
        end
        state.isInTank = true
    end
end

local function leaveTank()
    if not state.isInTank then return end
    local leaveRemote = ReplicatedStorage:FindFirstChild("SchwimmtankVerlassen")
    if leaveRemote then
        leaveRemote:FireServer()
        state.isInTank = false
    end
end

local function placeAquarium(character, root)
    if not state.features.aquarium then return end
    
    local aquariumRemote = ReplicatedStorage:FindFirstChild("AquariumPlatzieren")
    local leisteRemote = ReplicatedStorage:FindFirstChild("LeisteSpeichern")
    if not aquariumRemote then return end

    -- 1. Find Owned Aquarium Base in workspace.Aquarien
    local aquarienFolder = workspace:FindFirstChild(CONFIG.AQUARIUM_FOLDER_NAME)
    if not aquarienFolder then return end

    local ownedAquarium = nil
    for i = 1, CONFIG.AQUARIUM_MAX_INDEX do
        local aquarium = aquarienFolder:FindFirstChild("Aquarium" .. i)
        if aquarium then
            if aquarium:GetAttribute("BesitzerName") == LocalPlayer.Name then
                ownedAquarium = aquarium
                break
            end
        end
    end

    if not ownedAquarium then return end

    local bodenCF = ownedAquarium:GetAttribute("BodenCF")
    if not bodenCF then return end

    -- 2. Identify Best Eggs
    local function isEgg(tool)
        return tool:GetAttribute("EiId") ~= nil or tool:GetAttribute("Kategorie") == "Eier"
    end

    local function mutationCount(tool)
        local mut = tool:GetAttribute("Mutation")
        if type(mut) ~= "string" or mut == "" then return 0 end
        local count = 0
        for _ in mut:gmatch("%+") do count += 1 end
        return count
    end

    local function eggBetter(a, b)
        local stageA = tonumber(a:GetAttribute("EiStage")) or 0
        local stageB = tonumber(b:GetAttribute("EiStage")) or 0
        if stageA ~= stageB then return stageB < stageA end
        
        local sorteA = tonumber(a:GetAttribute("EiSorte")) or 0
        local sorteB = tonumber(b:GetAttribute("EiSorte")) or 0
        if sorteA ~= sorteB then return sorteB < sorteA end
        
        local mutA = mutationCount(a)
        local mutB = mutationCount(b)
        if mutA ~= mutB then return mutB < mutA end
        
        local hoeheA = tonumber(a:GetAttribute("EiHoehe")) or 0
        local hoeheB = tonumber(b:GetAttribute("EiHoehe")) or 0
        if hoeheA ~= hoeheB then return hoeheB < hoeheA end
        
        return tostring(a:GetAttribute("EiId")) < tostring(b:GetAttribute("EiId"))
    end

    local function schluesselVon(tool)
        local petId = tool:GetAttribute("PetId")
        if petId ~= nil then
            return "P" .. tostring(petId)
        end
        local eiId = tool:GetAttribute("EiId")
        if eiId == nil then
            return tool:GetAttribute("Dreizack") and "Dreizack" or "T" .. tool.Name
        end
        return "E" .. tostring(eiId)
    end

    -- Collect Eggs from Backpack and Character
    local eggs = {}
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and isEgg(tool) then
                table.insert(eggs, tool)
            end
        end
    end
    if character then
        for _, tool in ipairs(character:GetChildren()) do
            if tool:IsA("Tool") and isEgg(tool) then
                table.insert(eggs, tool)
            end
        end
    end

    if #eggs == 0 then return end

    table.sort(eggs, function(a, b) return eggBetter(a, b) end)
    local bestEgg = eggs[1]

    -- 3. Teleport to Base if Far Away
    local playerPos = root.Position
    local distToBase = (playerPos - bodenCF.Position).Magnitude
    
    if distToBase > 10 then
        if state.isInTank then
            leaveTank()
            task.wait(0.5)
        end

        local targetPos = Vector3.new(bodenCF.X, bodenCF.Y + 1, bodenCF.Z)
        root.CFrame = CFrame.new(targetPos, targetPos + Vector3.new(0, 2, 0))
        breakVelocity(character)
        task.wait(1.5)
    end

    -- 4. Equip Best Egg
    if bestEgg.Parent ~= character then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid:EquipTool(bestEgg)
            task.wait(0.2)
        end
    end

    if bestEgg.Parent ~= character then
        return
    end

    -- 5. Sync Hotbar Layout (LeisteSpeichern)
    if leisteRemote then
        local payload = {}
        local bestKey = schluesselVon(bestEgg)
        payload[bestKey] = 1
        leisteRemote:FireServer(payload)
        task.wait(0.1)
    end

    -- 6. Place Egg
    task.wait(0.5)
    aquariumRemote:FireServer(bestEgg, bodenCF.X, bodenCF.Y)
    
    if _G.updateStatusLabel then
        _G.updateStatusLabel("Aqua", `Placed: ${bestEgg.Name}`)
    end

    -- 7. Return to Home/Tank for Speed Farming
    if state.homeCFrame then
        root.CFrame = state.homeCFrame
        breakVelocity(character)
        task.wait(0.5)
        
        if state.features.farm then
            enterTank()
        end
    end
end

local function autoOpenEggs(character, root)
    if not state.features.autoOpenEggs then return end

    local aquarienFolder = workspace:FindFirstChild(CONFIG.AQUARIUM_FOLDER_NAME)
    if not aquarienFolder then return end

    local ownedAquarium = nil
    for i = 1, CONFIG.AQUARIUM_MAX_INDEX do
        local aquarium = aquarienFolder:FindFirstChild("Aquarium" .. i)
        if aquarium and aquarium:GetAttribute("BesitzerName") == LocalPlayer.Name then
            ownedAquarium = aquarium
            break
        end
    end

    if not ownedAquarium then return end

    local brutplaetze = ownedAquarium:FindFirstChild("Brutplaetze")
    if not brutplaetze then return end

    local readyEggs = {}
    for _, desc in ipairs(brutplaetze:GetDescendants()) do
        if desc.Name == "OeffnenKnopf" and desc:IsA("BasePart") then
            local prompt = desc:FindFirstChild("EiOeffnen")
            if prompt and prompt:IsA("ProximityPrompt") then
                table.insert(readyEggs, { part = desc, prompt = prompt })
            end
        end
    end

    if #readyEggs == 0 then return end

    for _, eggData in ipairs(readyEggs) do
        local part = eggData.part
        local prompt = eggData.prompt
        local eggPos = part.Position
        local playerPos = root.Position
        local distance = (eggPos - playerPos).Magnitude

        if distance > CONFIG.OPEN_RADIUS then
            if state.isInTank then
                leaveTank()
                task.wait(0.2)
            end
            
            root.CFrame = CFrame.new(eggPos.X, eggPos.Y + 3, eggPos.Z)
            breakVelocity(character)
            task.wait(0.5)
        end

        firePromptStandard(prompt)
        
        if _G.updateStatusLabel then
            _G.updateStatusLabel("Eggs", `Opened ${#readyEggs} ready`)
        end

        task.wait(0.1)
    end

    if state.homeCFrame then
        root.CFrame = state.homeCFrame
        breakVelocity(character)
        task.wait(0.2)
        
        if state.features.farm then
            enterTank()
        end
    end
end

local function autoBuyFin()
    if not state.features.autoBuyFin then return end
    
    local currentMoney = LocalPlayer:GetAttribute("Muenzen")
    if not currentMoney or currentMoney <= 0 then return end

    local ownedFins = LocalPlayer:GetAttribute("FlossenBesitz")
    
    local ownedLookup = {}
    
    if ownedFins then
        local ok, decoded = pcall(function()
            return HttpService:JSONDecode(ownedFins)
        end)
        
                if ok and type(decoded) == "table" then
            for _, finId in ipairs(decoded) do
                if type(finId) == "string" then
                    ownedLookup[finId] = true
                end
            end
        elseif type(ownedFins) == "table" then
            for _, finId in ipairs(ownedFins) do
                if type(finId) == "string" then
                    ownedLookup[finId] = true
                end
            end
        else
            for finId in string.gmatch(ownedFins, "([^,]+)") do
                finId = finId:match("^%s*[\"']?(.-)[\"']?%s*$")
                if finId and finId ~= "" then
                    ownedLookup[finId] = true
                end
            end
        end
    end

    local bestFinToBuy = nil
    local maxAffordablePrice = 0

    for _, fin in ipairs(FIN_LIST) do
        if ownedLookup[fin.Id] then
            continue
        end
        
        if fin.Starter and currentMoney > 1000 then
            continue
        end
        
        if fin.Preis <= currentMoney and fin.Preis > maxAffordablePrice then
            maxAffordablePrice = fin.Preis
            bestFinToBuy = fin
        end
    end

    if bestFinToBuy then
        local flossenAktion = ReplicatedStorage:FindFirstChild("FlossenAktion")
        if flossenAktion then
            local args = {
                "kaufen",
                bestFinToBuy.Id
            }
            flossenAktion:InvokeServer(unpack(args))
            if _G.updateStatusLabel then
                _G.updateStatusLabel("Fin", `Bought: ${bestFinToBuy.Name}`)
            end
        end
    end
end

