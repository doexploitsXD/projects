local function getMyFarmTarget()
	local playerName = LocalPlayer.Name

	local ownedTank = nil
	local nearestDist = math.huge
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then return end

	local currentPos = root.Position

	for _, model in ipairs(workspace:GetChildren()) do
		if model:IsA("Model") and model.Name == "Wassertank" then
			local owner = model:GetAttribute("BesitzerName")
			if owner == playerName then
				local refPart = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChildWhichIsA("BasePart")
				if refPart then
					local dist = (currentPos - refPart.Position).Magnitude
					if dist < nearestDist then
						nearestDist = dist
						ownedTank = model
					end
				end
			end
		end
	end

	if not ownedTank then return nil, nil end

	local wasserPart = ownedTank:FindFirstChild("Wasser")
	if not wasserPart then return nil, nil end

	local tankPrompt = nil
	local einstieg = wasserPart:FindFirstChild("Einstieg")
	if einstieg then
		tankPrompt = einstieg:FindFirstChild("TankPrompt")
	end

	return wasserPart.Position, tankPrompt
end

local function enterTank()
	if state.isInTank then return end

	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then return end

	local farmPos, farmPrompt = getMyFarmTarget()

	if not farmPrompt then return end
	local distance = (root.Position - farmPos).Magnitude
	local maxDist = farmPrompt.MaxActivationDistance or CONFIG.OPEN_RADIUS

	if distance > maxDist then
		root.CFrame = CFrame.new(farmPos + Vector3.new(0, 3, 0), farmPos)
		breakVelocity(character)
		task.wait(0.5)
	end

	if firePromptStandard(farmPrompt) then
		state.isInTank = true
		if _G.updateStatusLabel then
			_G.updateStatusLabel("Farm", "Entered Tank")
		end
	end
end

local function leaveTank()
	if not state.isInTank then return end
	local leaveRemote = ReplicatedStorage:FindFirstChild("SchwimmtankVerlassen")
	if leaveRemote then
		leaveRemote:FireServer()
		state.isInTank = false
	end
end

