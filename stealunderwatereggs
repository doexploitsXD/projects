local function autoBuyTank()
	if not state.features.autoBuyTank then return end

	local playerName = LocalPlayer.Name
	local ownedTank = nil

	for _, model in ipairs(workspace:GetChildren()) do
		if model:IsA("Model") and model.Name == "Wassertank" then
			if model:GetAttribute("BesitzerName") == playerName then
				ownedTank = model
				break
			end
		end
	end

	if not ownedTank then return end

	local currentLevel = ownedTank:GetAttribute("TankStufe") or 1
	if currentLevel >= TANK_CONFIG.MaxStufe then return end
	local nextLevel = currentLevel + 1
	local nextUpgrade = TANK_CONFIG.Stufen[nextLevel]

	if not nextUpgrade then return end

	local currentMoney = LocalPlayer:GetAttribute("Muenzen") or 0

	if nextUpgrade.Kosten and currentMoney >= nextUpgrade.Kosten then
		local tankUpgradeEvent = ReplicatedStorage:FindFirstChild("TankUpgradeEvent")
		if tankUpgradeEvent then
			local args = {
				nextLevel,
				"geld"
			}
			tankUpgradeEvent:FireServer(unpack(args))

			if _G.updateStatusLabel then
				_G.updateStatusLabel("Tank", `Upgraded to Level ${nextLevel}`)
			end
		end
	end
end

local function isTsunamiActive()
	local tsunamiStart = workspace:GetAttribute("TsunamiStart")
	if type(tsunamiStart) ~= "number" then return false end

	local now = workspace:GetServerTimeNow()
	local elapsed = now - tsunamiStart

	local TsunamiConfig = ReplicatedStorage:FindFirstChild("TsunamiConfig")
	if not TsunamiConfig then return false end

	local config = require(TsunamiConfig)
	local fahrt = config.FahrtDauer()
	local totalDuration = fahrt + 3 + 7  
	return elapsed < totalDuration
end

local function autoClaimIndex()
	if not state.features.autoClaimIndex then return end

	local indexFolder = ReplicatedStorage:FindFirstChild("IndexBelohnung")
	if not indexFolder then return end

	local standRemote = indexFolder:FindFirstChild("Stand")
	local abholenRemote = indexFolder:FindFirstChild("Abholen")

	if not standRemote or not abholenRemote then return end

	local success, status = pcall(function()
		return standRemote:InvokeServer()
	end)

	if not success or type(status) ~= "table" then return end

	local claimedSomething = false

	if status.stages then
		for stageId, data in pairs(status.stages) do
			if data and data.zustand == "bereit" then
				local claimStage = tonumber(stageId) or 0

				if type(data.offen) == "table" then
					for key, _ in pairs(data.offen) do
						local ok, err = pcall(function()
							abholenRemote:InvokeServer(claimStage, key)
						end)
						if ok then
							claimedSomething = true
							if _G.updateStatusLabel then
								_G.updateStatusLabel("Index", `Claimed Stage ${claimStage} (${key})`)
							end
						end
					end
				else
					local keysToTry = { "Half", "Most", "Full" }
					for _, key in ipairs(keysToTry) do
						local ok, err = pcall(function()
							abholenRemote:InvokeServer(claimStage, key)
						end)
						if ok then
							claimedSomething = true
							if _G.updateStatusLabel then
								_G.updateStatusLabel("Index", `Claimed Stage ${claimStage} (${key})`)
							end
							break
						end
					end
				end
			end
		end
	end

	if status.voll and status.voll.zustand == "bereit" then
		local ok, err = pcall(function()
			abholenRemote:InvokeServer(0, "Voll")
		end)
		if ok then
			claimedSomething = true
			if _G.updateStatusLabel then
				_G.updateStatusLabel("Index", "Claimed Full Index")
			end
		end
	end

	if claimedSomething then
		notify("Index Rewards", "Claimed pending rewards.")
	end
end

local function forceStandUp(character)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		if humanoid.Sit then
			humanoid.Sit = false
		end
	end
end

-- MAIN LOOP
task.spawn(function()
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	while not root do
		task.wait(0.5)
		character = LocalPlayer.Character
		root = character and character:FindFirstChild("HumanoidRootPart")
	end

	local initialFarmPos, _ = getMyFarmTarget()
	state.homeCFrame = initialFarmPos and CFrame.new(initialFarmPos + Vector3.new(0, 3, 0)) or root.CFrame

	state.lastPetTime = tick()
	state.lastAquaTime = tick()
	state.lastFinTime = tick()
	state.lastEggOpenTime = tick()
	state.lastTankTime = tick()
	state.lastIndexTime = tick()

	while state.running do
		local currentTick = tick()

		forceStandUp(character)

		if currentTick - state.lastPetTime >= CONFIG.PET_REFRESH_INTERVAL then
			equipBestPet()
			state.lastPetTime = currentTick
		end

		if currentTick - state.lastAquaTime >= CONFIG.AQUARIUM_REFRESH_INTERVAL then
			placeAquarium(character, root)
			state.lastAquaTime = currentTick
		end

		if currentTick - state.lastEggOpenTime >= CONFIG.EGG_OPEN_INTERVAL then
			autoOpenEggs(character, root)
			state.lastEggOpenTime = currentTick
		end

		if currentTick - state.lastFinTime >= CONFIG.FIN_REFRESH_INTERVAL then
			autoBuyFin()
			state.lastFinTime = currentTick
		end

		if currentTick - state.lastTankTime >= CONFIG.FIN_REFRESH_INTERVAL then
			autoBuyTank()
			state.lastTankTime = currentTick
		end

		if currentTick - state.lastIndexTime >= 30 then
			autoClaimIndex()
			state.lastIndexTime = currentTick
		end

		local tsunamiActive = isTsunamiActive()

		if tsunamiActive then
			if _G.updateStatusLabel then
				_G.updateStatusLabel("Eggs", "Tsunami active - waiting")
			end
		else
			local nestPlaetze = workspace:FindFirstChild("NestPlaetze")
			local eggFound = false
			local eggToGrab, stageToGrab, slotToGrab = nil, 0, 0

			if state.features.eggs and nestPlaetze then
				for stage = CONFIG.STAGE_MIN, CONFIG.STAGE_MAX do
					if eggFound then break end

					local stageObj = nestPlaetze:FindFirstChild("Stage" .. stage)
					if not stageObj then continue end

					for slot = 1, CONFIG.SLOTS_PER_STAGE do
						if eggFound then break end

						local platz = stageObj:FindFirstChild("Platz" .. slot)
						if not platz then continue end

						local egg = platz:FindFirstChild(CONFIG.EGG_NAME)

						if not egg then
							for _, child in ipairs(platz:GetChildren()) do
								if child:IsA("BasePart") or child:IsA("Model") then
									if findBestPrompt(child) then
										egg = child
										break
									end
								end
							end
						end

						if egg and isHighQualityEgg(egg) then
							eggFound = true
							eggToGrab, stageToGrab, slotToGrab = egg, stage, slot
							break
						end
					end
				end
			end
			if eggFound then
				if state.isInTank then
					leaveTank()
					task.wait(0.1)
				end

				local eggPos = eggToGrab:IsA("BasePart") and eggToGrab.Position or eggToGrab:GetPivot().Position
				local distance = (eggPos - root.Position).Magnitude
				local needsTeleport = distance > CONFIG.OPEN_RADIUS

				if needsTeleport then
					local offset = Vector3.new(3, 3, 0)
					local targetPos = eggPos + offset

					root.CFrame = CFrame.new(targetPos, targetPos + Vector3.new(0, 2, 0))
					breakVelocity(character)
					task.wait(0.2)
				end

				local rootPart = eggToGrab:FindFirstChild("Root")
				local prompt = rootPart and rootPart:FindFirstChild("EiAufheben")

				if not prompt then
					for _, desc in ipairs(eggToGrab:GetDescendants()) do
						if desc.Name == "EiAufheben" and desc:IsA("ProximityPrompt") then
							prompt = desc
							break
						end
					end
				end

				if prompt then
					local success = firePromptStandard(prompt)

					if not success then
						task.wait(0.1)
						local nudgePos = root.Position + Vector3.new(0.5, 0, 0)
						root.CFrame = CFrame.new(nudgePos, nudgePos + Vector3.new(0, 2, 0))
						breakVelocity(character)
						task.wait(0.1)
						success = firePromptStandard(prompt)
					end

					if success then
						state.totalGrabbed += 1
						if _G.updateStatusLabel then
							_G.updateStatusLabel("Eggs", `Total: ${state.totalGrabbed}`)
						end
					end
				end

				task.wait(CONFIG.GRAB_DELAY)

				if needsTeleport then
					root.CFrame = state.homeCFrame
					breakVelocity(character)
					task.wait(0.2)
				end
			else
				if state.features.farm then
					if not state.isInTank then
                        local farmPos, farmPrompt = getMyFarmTarget()

						if farmPos then
							root.CFrame = CFrame.new(farmPos + Vector3.new(0, 3, 0), farmPos)
							breakVelocity(character)
							task.wait(0.5)

							state.homeCFrame = CFrame.new(farmPos + Vector3.new(0, 3, 0), farmPos)

							if farmPrompt then
								firePromptStandard(farmPrompt)
								state.isInTank = true
							end
						else
							if state.homeCFrame and (root.Position - state.homeCFrame.Position).Magnitude > 10 then
								root.CFrame = state.homeCFrame
								breakVelocity(character)
								task.wait(0.1)
							end
						end
					else
						if state.homeCFrame then
							local dist = (root.Position - state.homeCFrame.Position).Magnitude
							if dist > 10 then
								root.CFrame = state.homeCFrame
								breakVelocity(character)
								task.wait(0.1)
							end
						end
					end
				end
			end
		end

		task.wait(CONFIG.SCAN_DELAY)
	end
end)

