local function breakVelocity(character)
    local V3 = Vector3.new(0, 0, 0)
    for _, v in ipairs(character:GetDescendants()) do
        if v:IsA("BasePart") then
            v.Velocity, v.RotVelocity = V3, V3
        end
    end
end

local function findBestPrompt(target)
    local prompt = target:FindFirstChildOfClass("ProximityPrompt")
    if prompt then return prompt end
    for _, desc in ipairs(target:GetDescendants()) do
        if desc:IsA("ProximityPrompt") then
            return desc
        end
    end
    return nil
end

local function firePromptStandard(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return false end
    if not prompt.Enabled then prompt.Enabled = true end
    local holdDuration = prompt.HoldDuration or 0.0
    if fireproximityprompt then
        fireproximityprompt(prompt)
    end
    task.wait(holdDuration + 0.1)
    return true
end

