end

local function autoOpenEggs(character, root)
	if not state.features.autoOpenEggs then return end

	local aquarienFolder = workspace:FindFirstChild(CONFIG.AQUARIUM_FOLDER_NAME)
	if not aquarienFolder then return end

	local ownedAquarium = nil
	for i = 1, CONFIG.AQUARIUM_MAX_INDEX do
		local aquarium = aquarienFolder:FindFirstChild("Aquarium" .. i)
		if aquarium and aquarium:GetAttribute("BesitzerName") == LocalPlayer.Name then
			ownedAquarium = aquarium
			break
		end
	end

	if not ownedAquarium then return end

	local brutplaetze = ownedAquarium:FindFirstChild("Brutplaetze")
	if not brutplaetze then return end

	local readyEggs = {}
	for _, desc in ipairs(brutplaetze:GetDescendants()) do
		if desc.Name == "OeffnenKnopf" and desc:IsA("BasePart") then
			local prompt = desc:FindFirstChild("EiOeffnen")
			if prompt and prompt:IsA("ProximityPrompt") then
				table.insert(readyEggs, { part = desc, prompt = prompt })
			end
		end
	end

	if #readyEggs == 0 then return end

	local sumPos = Vector3.new(0, 0, 0)
	for _, eggData in ipairs(readyEggs) do
		sumPos += eggData.part.Position
	end
	local centroidPos = sumPos / #readyEggs
	local targetPos = Vector3.new(centroidPos.X, centroidPos.Y + 3, centroidPos.Z)

	local wasInTank = state.isInTank
	local needsTeleport = (root.Position - targetPos).Magnitude > CONFIG.OPEN_RADIUS

	if wasInTank then
		leaveTank()
		task.wait(0.2)
		state.isInTank = false
	end

	if needsTeleport or wasInTank then
		root.CFrame = CFrame.new(targetPos, targetPos + Vector3.new(0, 2, 0))
		breakVelocity(character)
		task.wait(0.5)
	end

	local openedCount = 0
	for _, eggData in ipairs(readyEggs) do
		local part = eggData.part
		local prompt = eggData.prompt

		local maxDist = prompt.MaxActivationDistance or CONFIG.OPEN_RADIUS
		local distance = (part.Position - root.Position).Magnitude

		if distance <= maxDist then
			if firePromptStandard(prompt) then
				openedCount += 1
			end
			task.wait(0.1)
		end
	end

	if _G.updateStatusLabel and openedCount > 0 then
		_G.updateStatusLabel("Eggs", `Opened ${openedCount} ready`)
	end

	if state.homeCFrame then
		local distToHome = (root.Position - state.homeCFrame.Position).Magnitude

		if distToHome > 10 then
			root.CFrame = state.homeCFrame
			breakVelocity(character)
			task.wait(0.5)
		end

		if state.features.farm and not state.isInTank then
			task.wait(0.2)
			enterTank()
		end
	end
end

local function autoBuyFin()
	if not state.features.autoBuyFin then return end

	local currentMoney = LocalPlayer:GetAttribute("Muenzen")
	if not currentMoney or currentMoney <= 0 then return end

	local ownedFins = LocalPlayer:GetAttribute("FlossenBesitz")

	local ownedLookup = {}

	if ownedFins then
		local ok, decoded = pcall(function()
			return HttpService:JSONDecode(ownedFins)
		end)

		if ok and type(decoded) == "table" then
			for _, finId in ipairs(decoded) do
				if type(finId) == "string" then
					ownedLookup[finId] = true
				end
			end
		elseif type(ownedFins) == "table" then
			for _, finId in ipairs(ownedFins) do
				if type(finId) == "string" then
					ownedLookup[finId] = true
				end
			end
		else
			for finId in string.gmatch(ownedFins, "([^,]+)") do
				finId = finId:match("^%s*[\"']?(.-)[\"']?%s*$")
				if finId and finId ~= "" then
					ownedLookup[finId] = true
				end
			end
		end
	end

	local bestFinToBuy = nil
	local maxAffordablePrice = 0

	for _, fin in ipairs(FIN_LIST) do
		if ownedLookup[fin.Id] then
			continue
		end

		if fin.Starter and currentMoney > 1000 then
			continue
		end

		if fin.Preis <= currentMoney and fin.Preis > maxAffordablePrice then
			maxAffordablePrice = fin.Preis
			bestFinToBuy = fin
		end
	end

	if bestFinToBuy then
		local flossenAktion = ReplicatedStorage:FindFirstChild("FlossenAktion")
		if flossenAktion then
			local args = {
				"kaufen",
				bestFinToBuy.Id
			}
			flossenAktion:InvokeServer(unpack(args))
			if _G.updateStatusLabel then
				_G.updateStatusLabel("Fin", `Bought: ${bestFinToBuy.Name}`)
			end
		end 
	end
end

