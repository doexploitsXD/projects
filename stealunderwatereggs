	local function formatNumber(num)
		if type(num) ~= "number" then return "0" end
		if num >= 1000000000000 then
			return string.format("%.1fT", num / 1000000000000)
		elseif num >= 1000000000 then
			return string.format("%.1fB", num / 1000000000)
		elseif num >= 1000000 then
			return string.format("%.1fM", num / 1000000)
		elseif num >= 1000 then
			return string.format("%.1fK", num / 1000)
		elseif num >= 100 then
			return string.format("%.0f", num)
		else
			return string.format("%.1f", num)
		end
	end

	task.spawn(function()
		while state.running do
			if activeTab == "stats" then
				local money = LocalPlayer:GetAttribute("Muenzen") or 0
				statMoney.Text = formatNumber(money)

				local income = LocalPlayer:GetAttribute("GeldProSekunde") or 0
				statIncome.Text = formatNumber(income)

				local speed = LocalPlayer:GetAttribute("Speed") or 0
				statSpeed.Text = formatNumber(speed)

				local tankLevel = LocalPlayer:GetAttribute("TankStufe") or 1
				if not LocalPlayer:GetAttribute("TankStufe") then
					for _, model in ipairs(workspace:GetChildren()) do
						if model:IsA("Model") and model.Name == "Wassertank" then
							if model:GetAttribute("BesitzerName") == LocalPlayer.Name then
								tankLevel = model:GetAttribute("TankStufe") or 1
								break
							end
						end
					end
				end
				statTank.Text = "Lv " .. tostring(tankLevel)
				statEggs.Text = tostring(state.totalGrabbed)

				if isTsunamiActive() then
					statTsunami.Text = "Active"
					statTsunami.TextColor3 = C.DANGER
				else
					statTsunami.Text = "Inactive"
					statTsunami.TextColor3 = C.SUCCESS
				end
