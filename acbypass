local Namecall; Namecall = hookmetamethod(game, "__namecall", function(...)
    if checkcaller() then return Namecall(...) end
    
    local Arguments = {...}
    local Self = Arguments[1]
    local Method = getnamecallmethod()
    local CallingScript = getcallingscript()
    
    local isTargetScript = (CallingScript and CallingScript.Name == "94E626E6-9E40-4C35-9B68-252ABC214F7E")

    if Method == "FireServer" and Self.Name == "NetSync" then
        if isTargetScript then
            local msgType = Arguments[2]
            local code = Arguments[3]

            if msgType == "m" then
                local physicsCodes = {
                    [18] = true,
                    [37] = true,
                    [52] = true,
                    [64] = true,
                }
                
                if physicsCodes[code] then
                    print("suppressed code: " .. code .. " | Data: " .. tostring(Arguments[4]))
                    return nil
                end
            end

            if msgType == "m" then
                 print("suppressed non-physics code: " .. tostring(code))
                 return nil
            end
        else            
            local msgType = Arguments[2]
            if msgType == "h" or msgType == "a" then
                return Namecall(unpack(Arguments))
            end
            if msgType == "m" then
                return nil
            end
        end
    end

    if Method == "Connect" and (Self.Name == "AC_Meldung" or Self.Name == "AC_Warnung") then
        local callback = Arguments[2]

        local wrappedCallback = function(...)
            local args = {...}
            local data = args[1]
            
            if type(data) == "table" and data.punkte then
                data.punkte = 0
            end
            
            return callback(...)
        end
        
        return Namecall(Self, "Connect", wrappedCallback)
    end
    
    return Namecall(unpack(Arguments))
end)
