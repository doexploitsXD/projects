local ReplicatedStorage = game:GetService("ReplicatedStorage")

local codelist = {
    [18] = true,
    [29] = true,
    [37] = true,
    [46] = true,
    [52] = true,
    [64] = true,
    [71] = true,
    [83] = true,
    [95] = true
}

local Namecall; Namecall = hookmetamethod(game, "__namecall", function(...)
    if checkcaller() then return Namecall(...) end
    
    local Arguments = {...}
    local Self = Arguments[1]
    local Method = getnamecallmethod()
    
    if Method == "FireServer" and Self.Name == "NetSync" then
        local msgtype = Arguments[2]
        local code = Arguments[3]
        local data = Arguments[4]

        if msgtype == "h" or msgtype == "a" or msgtype == "w" then
            return Namecall(unpack(Arguments))
        end

        if msgtype == "m" then
            if codelist[code] then
            print(code)
                return nil
            end
        end

        if msgtype == "k" or msgtype == "b" then
            Arguments[3] = {} 
            return Namecall(unpack(Arguments))
        end
        
        if msgtype == "t" then
            Arguments[3] = { {}, {}, {} }
            return Namecall(unpack(Arguments))
        end

        return Namecall(unpack(Arguments))
    end
    
    if Method == "Connect" then
        if Self.Name == "AC_Warnung" then
            local callback = Arguments[2]
            local wrappedCallback = function(...)
                local ACRemotes = ReplicatedStorage:FindFirstChild("AntiCheatRemotes")
                if ACRemotes then
                    for _, child in ipairs(ACRemotes:GetChildren()) do
                        if child:IsA("Folder") or child:IsA("Model") then
                            for _, sub in ipairs(child:GetChildren()) do
                                if sub:IsA("Sound") and sub.IsPlaying then
                                    sub:Stop()
                                end
                            end
                        end
                    end
                end
                return callback()
            end
            return Namecall(Self, "Connect", wrappedCallback)
        end
        
        if Self.Name == "AC_Meldung" then
            local callback = Arguments[2]
            local wrappedCallback = function(data)
                return callback(data)
            end
            return Namecall(Self, "Connect", wrappedCallback)
        end
    end

    if Method == "InvokeServer" then
        if Self.Name == "AC_Aktion" then
            local action = Arguments[2]
            local payload = Arguments[3]
            
            if type(payload) ~= "table" then
                payload = {}
            end

            if action == "bannen" or action == "entbannen" or action == "banDauer" then
                if not payload.userId and not payload.name then
                    return false, "Missing target identifier"
                end
            end

            if action == "schalter" then
                if type(payload) == "table" and payload.pfad then
                    if payload.pfad == "AN.Bewegung" then
                        payload.wert = true
                    end
                    if payload.pfad == "CLIENT.WERKZEUG_BAN" then
                        payload.wert = true
                    end
                end
            end

            if action == "notiz" then
                if type(payload.text) == "string" then
                    payload.text = string.sub(payload.text, 1, 500)
                end
            end

            Arguments[3] = payload
            return Namecall(unpack(Arguments))
        end
        
        if Self.Name == "AC_Daten" then
            return Namecall(unpack(Arguments))
        end
    end
    
    return Namecall(unpack(Arguments))
end)

